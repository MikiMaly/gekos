{
  "name": "gekos",
  "version": "0.0.1",
  "private": true,
  "description": "Care tracker for 3 crested geckos — sub-app of MikiMaly/hub at /private/geckos",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev ./public",
    "db:migrate:local": "wrangler d1 migrations apply gekos --local",
    "db:migrate:remote": "wrangler d1 migrations apply gekos --remote",
    "db:seed:local": "wrangler d1 execute gekos --local --file=./migrations/0002_seed.sql",
    "db:seed:remote": "wrangler d1 execute gekos --remote --file=./migrations/0002_seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.99.0"
  }
}
